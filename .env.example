# Build
MOODLE_GIT_REF=MOODLE_520_STABLE
MOODLE_APP_IMAGE=academiamirai/moodle-php:5.2
MOODLE_NGINX_IMAGE=academiamirai/moodle-nginx:5.2

# Runtime
MOODLE_URL=https://aula.academiamirai.mx
TZ=America/Mexico_City
MOODLE_AUTO_INSTALL=1
MOODLE_INSTALL_LANG=en
MOODLE_REVERSE_PROXY=1
MOODLE_SSL_PROXY=1

# Site bootstrap
MOODLE_SITE_FULLNAME=Aula Academia Mirai
MOODLE_SITE_SHORTNAME=Academia Mirai
MOODLE_SITE_SUMMARY=Plataforma de aprendizaje de Academia Mirai.
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=ChangeThisAdminPass123!
MOODLE_ADMIN_EMAIL=admin@academiamirai.mx
MOODLE_SUPPORT_EMAIL=soporte@academiamirai.mx

# Database
MOODLE_DB_HOST=mariadb
MOODLE_DB_PORT=3306
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle_user
MOODLE_DB_PASSWORD=ChangeThisDbPass123!
MOODLE_DB_ROOT_PASSWORD=ChangeThisRootPass123!
MOODLE_DB_PREFIX=mdl_

# Redis
MOODLE_USE_REDIS_SESSIONS=1
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=
REDIS_SESSION_PREFIX=mirai_sess_
REDIS_SESSION_LOCK_TIMEOUT=120
REDIS_SESSION_LOCK_RETRY=100

# PHP
PHP_MEMORY_LIMIT=512M
PHP_UPLOAD_MAX_FILESIZE=256M
PHP_POST_MAX_SIZE=256M
PHP_MAX_INPUT_VARS=5000
PHP_MAX_EXECUTION_TIME=300
PHP_MAX_INPUT_TIME=300

# Backups
BACKUP_DIR=/srv/backups/aulamirai
BACKUP_RETENTION_DAYS=7
